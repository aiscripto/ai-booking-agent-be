datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IndustryType {
  HEALTHCARE
  SALON_WELLNESS
  LEGAL_CONSULTING
  REAL_ESTATE
  AUTOMOTIVE
  FITNESS
  GENERAL
}

enum UserRole {
  ADMIN
  PROVIDER
  FRONT_DESK
  PATIENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  industry      IndustryType @default(GENERAL)
  branding      Json?        @map("branding")
  calApiKey     String?      @map("cal_api_key")
  calTeamId     Int?         @map("cal_team_id")
  isActive      Boolean      @default(true) @map("is_active")
  // Business details (Setup > Business)
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  latitude      Float?
  longitude     Float?
  // Opening hours: seven lists (Sunday first) of {start, end} ranges. Empty = not set (server defaults apply).
  businessHours Json?        @map("business_hours")
  // IANA time zone of the business, for example "America/New_York". Empty = the server default.
  timeZone      String?      @map("time_zone")
  // Last employee number handed out; the next employee gets this + 1 (assigned by the system)
  employeeSeq   Int          @default(0) @map("employee_seq")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  users             User[]
  grades            Grade[]
  serviceCategories ServiceCategory[]
  employeeTimeOff   EmployeeTimeOff[]
  employees         Employee[]
  roles             Role[]
  voiceAgents       VoiceAgent[]
  appointments      Appointment[] // Legacy appointment model for backward compatibility
  callLogs          CallLog[]
  googleCredential  GoogleCredential?

  // Universal Multi-Tenant Relations
  resources    Resource[]
  serviceTypes ServiceType[]
  customers    Customer[]
  bookings     Booking[]
  departments  Department[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resourceId   String?   @unique @map("resource_id") @db.Uuid
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // The role that decides what this user may do. If empty, the built-in role named by `role` applies.
  roleId       String?   @map("role_id") @db.Uuid
  roleRef      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  // Optional link to the person (employee record) this login belongs to.
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

model Department {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  code              String?
  description       String?
  buildingLocation  String?    @map("building_location")
  contact           String?
  email             String?
  isHipaaRestricted Boolean    @default(true) @map("is_hipaa_restricted")
  maxDailyBookings  Int        @default(25) @map("max_daily_bookings")
  isActive          Boolean    @default(true) @map("is_active")
  resources         Resource[]
  employees         Employee[]
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Resource {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId  String?     @map("department_id") @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name          String
  email         String
  title         String? // e.g. "Doctor of Medicine", "Master Stylist", "Senior Partner"
  avatarUrl     String?     @map("avatar_url")
  calUserId     Int?        @unique @map("cal_user_id")
  calScheduleId Int?        @map("cal_schedule_id")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user     User?
  bookings Booking[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("resources")
}

model ServiceType {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String // e.g. "Consultation", "Haircut", "Strategy Call"
  description     String?
  durationMinutes Int      @default(30) @map("duration_minutes")
  price           Decimal? @db.Decimal(10, 2)
  depositRequired Decimal? @map("deposit_required") @db.Decimal(10, 2)
  calEventTypeId  Int?     @unique @map("cal_event_type_id")
  intakeSchema    Json?    @map("intake_schema") // Dynamic JSON schema for intake fields
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([tenantId])
  @@map("service_types")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  metadata  Json?    @map("metadata") // Custom client metadata (e.g. medical ID, VIN)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookings Booking[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

model Booking {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  serviceTypeId String      @map("service_type_id") @db.Uuid
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Cal.com Mapping References
  calBookingId Int?    @unique @map("cal_booking_id")
  calUid       String? @unique @map("cal_uid")

  bookingDateTime DateTime      @map("booking_date_time")
  durationMinutes Int           @default(30) @map("duration_minutes")
  status          BookingStatus @default(CONFIRMED)
  meetingUrl      String?       @map("meeting_url") // Telehealth / Video URL
  isActive        Boolean       @default(true) @map("is_active")

  // Dynamic Intake & Notes
  intakeData    Json?   @map("intake_data")
  providerNotes String? @map("provider_notes") @db.Text

  callLogId String?  @map("call_log_id") @db.Uuid
  callLog   CallLog? @relation(fields: [callLogId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Mathematical Anti-Double-Booking Constraint
  @@unique([tenantId, resourceId, bookingDateTime])
  @@index([tenantId])
  @@index([resourceId])
  @@index([status])
  @@map("bookings")
}

model VoiceAgent {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  systemPrompt  String   @map("system_prompt")
  voiceProvider String   @map("voice_provider") // vapi, retell
  voiceAgentId  String?  @map("voice_agent_id")
  calendarId    String   @map("calendar_id")
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  callLogs CallLog[]

  @@index([tenantId])
  @@map("voice_agents")
}

model Appointment {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarId          String           @map("calendar_id")
  appointmentDateTime DateTime         @map("appointment_date_time")
  customerName        String           @map("customer_name")
  customerPhone       String           @map("customer_phone")
  customerEmail       String?          @map("customer_email")
  status              String           @default("SCHEDULED")
  googleEventId       String?          @map("google_event_id")
  isActive            Boolean          @default(true) @map("is_active")
  // Who the appointment is with (a consultant), and what it is for. Empty for older bookings.
  employeeId          String?          @map("employee_id") @db.Uuid
  employee            Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  categoryId          String?          @map("category_id") @db.Uuid
  category            ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // ── Telehealth ────────────────────────────────────────────────────────────
  // The opaque id in the stable link sent to the customer
  // (https://<host>/j/<token>). Issued once at booking time and never rotated,
  // so an SMS already delivered stays valid across reschedules.
  joinToken        String?   @unique @map("join_token")
  // The provisioned room. Minted lazily on first visit rather than at booking
  // time: provider rooms expire, so a booking three weeks out would otherwise
  // ship a link that is already dead on arrival.
  meetingUrl       String?   @map("meeting_url")
  meetingProvider  String?   @map("meeting_provider")
  meetingExpiresAt DateTime? @map("meeting_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, calendarId, appointmentDateTime])
  @@index([tenantId])
  @@index([calendarId])
  @@index([appointmentDateTime])
  @@index([employeeId])
  @@map("appointments")
}

model CallLog {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voiceAgentId  String?     @map("voice_agent_id") @db.Uuid
  voiceAgent    VoiceAgent? @relation(fields: [voiceAgentId], references: [id], onDelete: Cascade)
  callSid       String?     @map("call_sid")
  duration      Int?
  status        String
  transcript    String?
  payload       Json        @map("payload")
  customerName  String?     @map("customer_name")
  customerPhone String?     @map("customer_phone")
  customerEmail String?     @map("customer_email")
  purpose       String?     @map("purpose")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([tenantId])
  @@index([voiceAgentId])
  @@map("call_logs")
}

model GoogleCredential {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_credentials")
}

/// A career grade, for example "G15". The code is chosen by the user; the id is internal.
model Grade {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String?
  isActive  Boolean    @default(true) @map("is_active")
  employees Employee[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("grades")
}

/// A person who works for the business. Different from a login (User) and from a bookable
/// provider (Resource). `code` is assigned by the system (EMP-0001, EMP-0002, ...).
model Employee {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  fullName     String            @map("full_name")
  email        String?
  phone        String?
  departmentId String?           @map("department_id") @db.Uuid
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  gradeId      String?           @map("grade_id") @db.Uuid
  grade        Grade?            @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  roleId       String?           @map("role_id") @db.Uuid
  role         Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  managerId    String?           @map("manager_id") @db.Uuid
  manager      Employee?         @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]        @relation("EmployeeManager")
  isActive     Boolean           @default(true) @map("is_active")
  // Consultant: takes appointments. `title` is what the voice agent says (for example "cardiologist").
  isBookable   Boolean           @default(false) @map("is_bookable")
  title        String?
  // Own weekly hours (seven lists, Sunday first). Empty = follows the business hours.
  workingHours Json?             @map("working_hours")
  categories   ServiceCategory[]
  timeOff      EmployeeTimeOff[]
  appointments Appointment[]
  user         User?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

/// What a user may do. `permissions` holds codes from the fixed list in src/config/permissions.ts.
/// The four built-in roles (isSystem) cannot be deleted; ADMIN always has every permission.
model Role {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  permissions String[]
  isActive    Boolean    @default(true) @map("is_active")
  isSystem    Boolean    @default(false) @map("is_system")
  users       User[]
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

/// What a caller books, for example "Dentist" or "Tax advice". Different from a Department (how the business
/// is organized): one consultant can serve several categories.
model ServiceCategory {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  employees    Employee[]
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("service_categories")
}

/// A whole-day absence of a consultant (holiday, leave). Dates are calendar dates in the business time zone.
model EmployeeTimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, employeeId])
  @@map("employee_time_off")
}
